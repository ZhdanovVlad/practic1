{
  "name": "conferencii-rf",
  "version": "1.0.0",
  "description": "Портал Конференции.РФ — бронирование помещений для конференций",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:up": "docker compose up -d",
